NODE_ENV=development
PORT=4000
# Random owner-only password: openssl rand -hex 32
DASHBOARD_TOKEN=replace-with-long-random-token
# Never put this in your Next.js / Vercel environment variables.
YOUTUBE_STREAM_KEY=your-secret-youtube-studio-stream-key
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com/live2
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_GB=4
DATA_DIR=./data
# Optional: serve a prebuilt Next.js dashboard from the same Node API.
# WEB_STATIC_DIR=./public
# LISTEN_HOST=127.0.0.1
# Optional encoder tuning for lower-powered devices.
# STREAM_WIDTH=854
# STREAM_HEIGHT=480
# STREAM_FPS=24
# STREAM_BITRATE_KBPS=1300
# STREAM_PRESET=ultrafast
