NODE_ENV=production
PORT=4000
LISTEN_HOST=127.0.0.1
WEB_STATIC_DIR=./public
# Personal phone mode: automatically opens dashboard without a login popup.
# NEVER enable this when publicly exposing port 4000 or using a tunnel.
LOCAL_ONLY_MODE=true
DATA_DIR=./data
FRONTEND_ORIGIN=http://127.0.0.1:4000,http://localhost:4000
# Not needed for local-only mode. Cloud deployments still require a token.
# One-time setup: YouTube Studio > Go live > Stream > Stream key.
# DO NOT share this key or put it in GitHub.
YOUTUBE_STREAM_KEY=your-secret-youtube-studio-stream-key
# Optional YouTube Live Automation: create a Web application OAuth client in
# Google Cloud Console and add this exact authorized redirect URI:
# http://127.0.0.1:4000/api/youtube/oauth/callback
# Keep these private in .env; never commit them to GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com/live2
MAX_UPLOAD_GB=2
# Termux-friendly 480p encoding preset. Raise carefully if the phone runs cool.
STREAM_WIDTH=854
STREAM_HEIGHT=480
STREAM_FPS=24
STREAM_BITRATE_KBPS=1300
STREAM_PRESET=ultrafast
