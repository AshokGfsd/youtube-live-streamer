NODE_ENV=production
PORT=4000
LISTEN_HOST=127.0.0.1
WEB_STATIC_DIR=./public
# Personal phone mode: automatically opens dashboard without a login popup.
# NEVER enable this when publicly exposing port 4000 or using a tunnel.
LOCAL_ONLY_MODE=true
DATA_DIR=./data
FRONTEND_ORIGIN=http://127.0.0.1:4000,http://localhost:4000
# Optional Cloud Shell Web Preview: allow a private proxy hostname while the API
# remains bound to loopback. Copy the exact HTTPS origin (no path/trailing slash).
# In Cloud Shell, run: printf 'https://4000-%s\n' "$WEB_HOST"
# Enabling either option REQUIRES a private DASHBOARD_TOKEN (24+ characters).
# Wildcard CORS does NOT make control endpoints public: remote requests still
# require the token. Keep both settings disabled for ordinary local/Termux use.
CLOUD_SHELL_PREVIEW_ORIGIN=
CORS_ALLOW_ALL_ORIGINS=false
DASHBOARD_TOKEN=
# Not needed for local-only mode. Cloud deployments still require a token.
# One-time setup: YouTube Studio > Go live > Stream > Stream key.
# DO NOT share this key or put it in GitHub.
YOUTUBE_STREAM_KEY=your-secret-youtube-studio-stream-key
# Optional YouTube Live Automation: create a Web application OAuth client in
# Google Cloud Console and add this exact authorized redirect URI:
# http://127.0.0.1:4000/api/youtube/oauth/callback
# Keep these private in .env; never commit them to GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com/live2
MAX_UPLOAD_GB=2
# Termux-friendly 480p encoding preset. Raise carefully if the phone runs cool.
STREAM_WIDTH=854
STREAM_HEIGHT=480
STREAM_FPS=24
STREAM_BITRATE_KBPS=1300
STREAM_PRESET=ultrafast
# Channel storage: file (recommended on Termux) or mysql (optional).
# Switching modes does NOT migrate existing channel records.
# Back up DATA_DIR and its generated encryption key before phone resets.
CHANNEL_STORAGE=file
# These fields are used only when CHANNEL_STORAGE=mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=streamforge
MYSQL_PASSWORD=
MYSQL_DATABASE=
# false = one YouTube channel only; true = allow managing several profiles.
# Existing channel data is preserved if you switch between the modes.
MULTI_CHANNEL_ENABLED=false
# Optional: select an existing channel by its UUID when you have several.
# Leave empty to use the most recently updated ready channel (or first draft).
SINGLE_CHANNEL_ID=
# The following .env values configure the single channel automatically on API
# restart. They override that channel's saved values when provided.
SINGLE_CHANNEL_NAME=ClueRipple Live
SINGLE_CHANNEL_HANDLE=
SINGLE_CHANNEL_YOUTUBE_CHANNEL_ID=
# Paste your REAL YouTube Studio stream key ONLY into your private .env,
# never into this tracked example or a chat message.
SINGLE_CHANNEL_STREAM_KEY=
SINGLE_CHANNEL_INGEST_URL=rtmps://a.rtmps.youtube.com/live2
SINGLE_CHANNEL_DEFAULT_TITLE=ClueRipple Live
SINGLE_CHANNEL_DEFAULT_DESCRIPTION=
SINGLE_CHANNEL_PRIVACY=private
SINGLE_CHANNEL_LOOP=true
# Optional in LOCAL_ONLY_MODE=true: StreamForge automatically creates a private
# encryption key in DATA_DIR. No manual security setup or login screen needed.
# Never delete the generated key file after saving channels: old data depends on it.
# For an explicit key (and mandatory in cloud mode), use: openssl rand -hex 32
CHANNEL_ENCRYPTION_KEY=
# Single-channel mode always limits concurrent encoders to 1.
MAX_CONCURRENT_STREAMS=1

# Termux uses Direct MP4 playlists (FFmpeg); Chrome, X11 and noVNC are not needed.
# Instagram browser capture is available on desktop/Codespaces only.
INSTAGRAM_DISPLAY=:1
INSTAGRAM_CDP_PORT=9222
