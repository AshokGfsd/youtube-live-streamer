# ==============================================================================
# StreamForge Windows Environment Configuration
# ==============================================================================
NODE_ENV=production
PORT=4000
LISTEN_HOST=127.0.0.1

# Point to prebuilt Next.js static dashboard relative to apps/api
WEB_STATIC_DIR=../../deploy/termux/public

# Personal Windows mode: opens dashboard at http://127.0.0.1:4000 without login token
# NEVER enable this when exposing port 4000 to a public network
LOCAL_ONLY_MODE=true

# Persistent storage directory on Windows (relative to apps/api or absolute)
DATA_DIR=./data

FRONTEND_ORIGIN=http://127.0.0.1:4000,http://localhost:4000

# Channel storage mode: 'file' (recommended on Windows, no MySQL required)
# Secrets and stream keys are AES-256-GCM encrypted in DATA_DIR/channels.json
CHANNEL_STORAGE=file

# Multi-channel studio: false = single-channel file storage mode (recommended without MySQL)
MULTI_CHANNEL_ENABLED=false

# Optional: Default YouTube stream key for legacy single-channel mode
# Get this from YouTube Studio -> Create -> Go live -> Stream -> Stream key
YOUTUBE_STREAM_KEY=

# YouTube Ingest Server
YOUTUBE_RTMPS_URL=rtmps://a.rtmps.youtube.com/live2

# Maximum upload file size in GB
MAX_UPLOAD_GB=4

# Video encoding defaults for Windows (720p 30fps)
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=30
STREAM_BITRATE_KBPS=2500
STREAM_PRESET=veryfast

# Optional: Google OAuth Automation for YouTube broadcasts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
