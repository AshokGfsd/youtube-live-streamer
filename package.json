{
  "name": "youtube-live-streamer",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/web", "apps/api"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:web": "npm run dev --workspace @streamforge/web",
    "dev:api": "npm run dev --workspace @streamforge/api",
    "build": "npm run build --workspace @streamforge/web",
    "build:android": "node scripts/build-android-kit.mjs",
    "prototype:reels:demo": "node scripts/instagram-reels-prototype.mjs --demo",
    "prototype:reels:instagram": "node scripts/instagram-reels-prototype.mjs --instagram",
    "test": "npm run test --workspace @streamforge/api"
  }
}
